<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ (API 30) restringe la visibilidad de otras apps instaladas.
        Sin estas <queries>, getLaunchIntentForPackage() siempre devuelve null
        aunque la app esté instalada -> el botón Carnet siempre acababa en Play Store.
    -->
    <queries>
        <package android:name="com.veriddica.vecard" />
        <package android:name="co.edu.unab.vecard" />
        <package android:name="co.edu.unab.carnet" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".UnabGoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icono_banu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_banu_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnabGo">

        <!--
            CONFIGURACION INTEGRAL ANTI-OVERLAY "Gira tu telefono":

            1. screenOrientation="portrait"
               Bloquea la app en vertical.

            2. resizeableActivity="false"
               Le dice al SO: "esta app NO se adapta a multi-window/multi-size,
               NO la trates como app responsive". Esto evita el conflicto que
               disparaba el overlay del sistema.

            3. configChanges
               Manejamos cambios de configuracion nosotros, sin recrear la
               Activity. Evita que el SO intercepte la rotacion.

            4. android:maxAspectRatio="2.4"
               Le dice al SO el aspect ratio maximo que soporta la app.
               Sin esto, Android intenta letterboxear pantallas muy alargadas
               y eso a veces dispara el overlay.

            5. android:supportsPictureInPicture="false"
               Confirma que no usamos PiP, otro feature que podria activar
               comportamientos extranios de window management.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:maxAspectRatio="2.4"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|locale|fontScale|layoutDirection|navigation"
            android:theme="@style/Theme.UnabGo"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UNABFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
