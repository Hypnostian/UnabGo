<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ (API 30) restringe la visibilidad de otras apps instaladas.
        Sin estas <queries>, getLaunchIntentForPackage() siempre devuelve null
        aunque la app esté instalada -> el botón Carnet siempre acababa en Play Store.
    -->
    <queries>
        <!-- App de carnet digital UNAB (Veridda VECard) -->
        <package android:name="com.veriddica.vecard" />
        <package android:name="co.edu.unab.vecard" />
        <package android:name="co.edu.unab.carnet" />

        <!-- Para que startActivity con http/https siempre funcione -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".UnabGoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icono_banu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_banu_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnabGo">

        <!--
            screenOrientation=userPortrait (soft-lock):
              - En PORTRAIT funciona como "portrait" normal en cualquier celular.
              - PERO el sistema NO activa el overlay "Gira tu telefono" que aparece
                en Android 14/15/16 emulators y dispositivos Xiaomi cuando se usa
                "portrait" estricto. El sistema simplemente respeta la preferencia
                del usuario en cuanto a rotacion.

            resizeableActivity=true le indica al sistema que la app soporta tamanos
            de ventana variables (foldables, multitask, escritorio), de modo que
            NO entra en compatibility mode.

            configChanges: la app maneja los cambios de configuracion sin reinicios.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="userPortrait"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|locale|fontScale|layoutDirection|uiMode|keyboardHidden"
            android:theme="@style/Theme.UnabGo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UNABFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
