<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ (API 30) restringe la visibilidad de otras apps instaladas.
        Sin estas <queries>, getLaunchIntentForPackage() siempre devuelve null
        aunque la app esté instalada -> el botón Carnet siempre acababa en Play Store.
    -->
    <queries>
        <package android:name="com.veriddica.vecard" />
        <package android:name="co.edu.unab.vecard" />
        <package android:name="co.edu.unab.carnet" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".UnabGoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icono_banu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_banu_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnabGo">

        <!--
            screenOrientation="sensor"
              La app acepta CUALQUIER orientacion (portrait, landscape, reverse).
              El sistema rota con el sensor del telefono.

              Esta es la clave para eliminar el overlay "Gira tu telefono":
              si la app NO declara una orientacion fija, Android NO tiene
              motivo para mostrar la sugerencia de rotar.

              Los Composables son responsive (LazyColumn, verticalScroll,
              fillMaxSize) y funcionan bien en portrait Y landscape.

            configChanges hace que la app NO se recree al rotar, manejamos
            el cambio internamente.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|locale|fontScale|layoutDirection|navigation"
            android:theme="@style/Theme.UnabGo"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UNABFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
