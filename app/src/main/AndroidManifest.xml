<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ (API 30) restringe la visibilidad de otras apps instaladas.
        Sin estas <queries>, getLaunchIntentForPackage() siempre devuelve null
        aunque la app esté instalada -> el botón Carnet siempre acababa en Play Store.
    -->
    <queries>
        <package android:name="com.veriddica.vecard" />
        <package android:name="co.edu.unab.vecard" />
        <package android:name="co.edu.unab.carnet" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".UnabGoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icono_banu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_banu_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnabGo">

        <!--
            Manifest LIMPIO: sin screenOrientation, sin configChanges, sin
            resizeableActivity, sin supports_size_changes.

            Razón: cualquier declaración relacionada con orientación o tamaño
            de ventana en el Manifest hace que HyperOS/MIUI active su feature
            "Modo de pantalla compatible" que dibuja el overlay "Gira tu telefono".

            Este overlay es un FEATURE DEL SISTEMA OPERATIVO XIAOMI controlado
            por el usuario en:
                Ajustes > Aplicaciones > Gestionar apps > UnabGo > Otros permisos
                > Modo de pantalla compatible (DESACTIVAR)

            Sin esa declaración el SO respeta la orientación natural del
            dispositivo (portrait por defecto en celulares).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UnabGo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UNABFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
