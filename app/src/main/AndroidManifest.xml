<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ (API 30) restringe la visibilidad de otras apps instaladas.
        Sin estas <queries>, getLaunchIntentForPackage() siempre devuelve null
        aunque la app esté instalada -> el botón Carnet siempre acababa en Play Store.
    -->
    <queries>
        <!-- App de carnet digital UNAB (Veridda VECard) -->
        <package android:name="com.veriddica.vecard" />
        <package android:name="co.edu.unab.vecard" />
        <package android:name="co.edu.unab.carnet" />

        <!-- Para que startActivity con http/https siempre funcione -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".UnabGoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icono_banu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_banu_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnabGo">

        <!--
            CLAVE PARA ELIMINAR "Gira tu telefono" DE HYPEROS/MIUI/Pixel emulators:

            android.supports_size_changes = true le dice al OS que la app maneja
            cambios de tamano de ventana correctamente (foldables, split screen,
            tablets, freeform). Esto desactiva el "Display compatibility mode"
            de Xiaomi/HyperOS que es el que muestra el overlay "Gira tu telefono".
        -->
        <meta-data
            android:name="android.supports_size_changes"
            android:value="true" />

        <!--
            NO declaramos screenOrientation a proposito.
              - Si lo ponemos "portrait", HyperOS/Pixel 8 emulator muestran el
                overlay "Gira tu telefono para ver el contenido".
              - Sin ese atributo, la app respeta la rotacion natural del
                dispositivo. Los Composables son responsive (LazyColumn,
                Column con verticalScroll, fillMaxSize) y se ven bien en
                portrait Y landscape.
              - En portrait (uso normal) la experiencia es identica a antes.

            resizeableActivity=true confirma soporte para multi-window.
            configChanges evita reinicios al rotar/cambiar idioma.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|locale|fontScale|layoutDirection|uiMode|keyboardHidden"
            android:theme="@style/Theme.UnabGo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UNABFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
